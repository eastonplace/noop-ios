    "Your Recovery on the watch face, with Effort and Rest in the rectangular card.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Recovery on the watch face, with Effort and Rest in the rectangular card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Recuperación (recuperación) en la esfera del reloj, con Esfuerzo y Descanso en la tarjeta rectangular."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La tua Recupero (recupero) sul quadrante, con Sforzo e Riposo nella scheda rettangolare."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A tua Recuperação (recuperação) no mostrador, com Esforço e Descanso no cartão retangular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "表盘上显示你的恢复（恢复），矩形卡片中显示消耗和休息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "錶面上顯示你的恢復（恢復），矩形卡片中則是消耗與休息。"
          }
        }
