    },
    "Sustained high load. A breather would land well.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhaltend hohe Belastung. Eine Pause täte gut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga alta sostenida. Un respiro te vendría bien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carico elevato e prolungato. Una pausa ti farebbe bene."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Carga elevada e prolongada. Uma pausa far-te-ia bem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负荷持续偏高，休息一下会更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "負荷持續偏高，休息一下會更好。"
          }
        }
      }
    },
    "The daily score is ready; today has not supplied enough hourly signal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tageswert liegt vor; heute fehlt noch genug Stundensignal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuación diaria está lista; hoy aún no hay suficiente señal por horas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il punteggio giornaliero è pronto; oggi non c'è ancora abbastanza segnale orario."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A pontuação diária está pronta; hoje ainda não há sinal horário suficiente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日评分已就绪，但今天的逐小时信号仍不足。"
