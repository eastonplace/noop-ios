# ── Finder metadata ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.localized
Icon?

# ── Swift / Xcode ───────────────────────────────────────────────
# Xcode project is generated from project.yml by XcodeGen — do not commit it.
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
# Keep only the generated project's pinned SwiftPM lockfile.
!Strand.xcodeproj/
Strand.xcodeproj/*
!Strand.xcodeproj/project.xcworkspace/
Strand.xcodeproj/project.xcworkspace/*
!Strand.xcodeproj/project.xcworkspace/xcshareddata/
Strand.xcodeproj/project.xcworkspace/xcshareddata/*
!Strand.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Strand.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Strand.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
build/
DerivedData/
.build/
Packages/*/.build/
Tools/*/.build/
*.swiftpm
.swiftpm/
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# ── App bundles / build output ──────────────────────────────────
*.app/
NOOP.app/

# ── IDE / editor ────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── Misc / secrets (never commit) ───────────────────────────────
*.log
.env
deploy.env
deploy.env.*
secrets.*

# ── Personal data — NEVER publish (real WHOOP/Apple Health exports) ──
Fixtures/
*.sqlite
*.sqlite-wal
*.sqlite-shm
export.xml
export.zip
*whoop_export*.zip
*apple_health*.zip

# Python bytecode
__pycache__/
*.pyc

# Local release artifacts
dist/
err.txt
